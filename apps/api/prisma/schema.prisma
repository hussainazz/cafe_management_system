generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = "DATABASE_URL"
}

enum UserRole {
  MANAGER
  STAFF
}

enum OrderChannel {
  TABLE
  TAKEAWAY
}

enum OrderState {
  OPEN
  DELETED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum DiscountKind {
  FIXED
  PERCENTAGE
}

enum PaymentMethod {
  CASH
  CARD_TERMINAL
  CARD_TRANSFER
}

enum TableOccupancyState {
  AVAILABLE
  OCCUPIED
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshSessions     RefreshSession[]
  authEvents          AuthEvent[]
  createdOrders       Order[]              @relation("OrderCreatedBy")
  deletedOrders       Order[]              @relation("OrderDeletedBy")
  paymentSettlements  PaymentSettlement[]
  settlementReversals SettlementReversal[]
  idempotencyRecords  IdempotencyRecord[]
  auditLogs           AuditLog[]
  cafeSettingsUpdates CafeSettings[]

  @@map("users")
}

model RefreshSession {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_sessions")
}

model AuthEvent {
  id         String   @id @default(uuid())
  userId     String?
  eventType  String
  requestId  String
  occurredAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([occurredAt])
  @@map("auth_events")
}

model Category {
  id           String    @id @default(uuid())
  name         String
  displayOrder Int
  isActive     Boolean   @default(true)
  archivedAt   DateTime?

  products Product[]

  @@index([isActive, displayOrder])
  @@map("categories")
}

model Product {
  id                         String        @id @default(uuid())
  categoryId                 String
  name                       String
  priceAmount                Int
  saleDiscountKind           DiscountKind?
  saleDiscountValue          Int?
  preparationDeadlineMinutes Int
  displayOrder               Int
  isActive                   Boolean       @default(true)
  isAvailable                Boolean       @default(true)
  archivedAt                 DateTime?

  category            Category             @relation(fields: [categoryId], references: [id])
  image               ProductImage?
  productOptionGroups ProductOptionGroup[]
  orderItems          OrderItem[]

  @@index([categoryId, isActive, isAvailable, displayOrder])
  @@map("products")
}

model ProductImage {
  id         String @id @default(uuid())
  productId  String @unique
  storageKey String
  altText    String

  product Product @relation(fields: [productId], references: [id])

  @@map("product_images")
}

model OptionGroup {
  id       String  @id @default(uuid())
  name     String
  isActive Boolean @default(true)

  productOptionGroups ProductOptionGroup[]
  options             Option[]

  @@map("option_groups")
}

model ProductOptionGroup {
  productId     String
  optionGroupId String
  displayOrder  Int

  product     Product     @relation(fields: [productId], references: [id])
  optionGroup OptionGroup @relation(fields: [optionGroupId], references: [id])

  @@id([productId, optionGroupId])
  @@map("product_option_groups")
}

model Option {
  id            String    @id @default(uuid())
  optionGroupId String
  name          String
  priceAmount   Int
  isActive      Boolean   @default(true)
  isAvailable   Boolean   @default(true)
  displayOrder  Int
  archivedAt    DateTime?

  optionGroup      OptionGroup       @relation(fields: [optionGroupId], references: [id])
  orderItemOptions OrderItemOption[]

  @@index([optionGroupId, isActive, isAvailable, displayOrder])
  @@map("options")
}

model CafeTable {
  id                        String              @id @default(uuid())
  name                      String
  seatingLimitMinutes       Int                 @default(45)
  displayOrder              Int
  isActive                  Boolean             @default(true)
  waiterCallEnabled         Boolean             @default(false)
  occupancyState            TableOccupancyState @default(AVAILABLE)
  occupiedAt                DateTime?
  occupancyReminderAt       DateTime?
  tableContextInvalidBefore DateTime?
  archivedAt                DateTime?

  orders        Order[]
  qrCredentials TableQrCredential[]
  waiterCalls   WaiterCall[]

  @@index([isActive, displayOrder])
  @@index([waiterCallEnabled, occupancyState])
  @@map("cafe_tables")
}

enum WaiterCallStatus {
  PENDING
  RESOLVED
}

model TableQrCredential {
  id        String    @id @default(uuid())
  tableId   String
  tokenHash String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  rotatedAt DateTime?

  table CafeTable @relation(fields: [tableId], references: [id])

  @@index([tableId])
  @@map("table_qr_credentials")
}

model WaiterCall {
  id             String           @id @default(uuid())
  tableId        String
  status         WaiterCallStatus @default(PENDING)
  version        Int              @default(1)
  requestedAt    DateTime         @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?

  table CafeTable @relation(fields: [tableId], references: [id])

  @@index([status, requestedAt])
  @@index([tableId, requestedAt])
  @@map("waiter_calls")
}

model Order {
  id                               String        @id @default(uuid())
  orderNumber                      String        @unique
  tableId                          String?
  createdById                      String
  channel                          OrderChannel
  state                            OrderState    @default(OPEN)
  paymentStatus                    PaymentStatus @default(UNPAID)
  version                          Int           @default(1)
  discountKind                     DiscountKind?
  discountValue                    Int?
  discountAmount                   Int           @default(0)
  discountReason                   String?
  subtotalAmount                   Int
  totalAmount                      Int
  paidAmount                       Int           @default(0)
  balanceAmount                    Int
  estimatedPreparationMinutes      Int           @default(0)
  tableSeatingLimitSnapshotMinutes Int?
  estimatedTableReleaseAt          DateTime?
  deletedById                      String?
  deletedAt                        DateTime?
  deletionReason                   String?
  createdAt                        DateTime      @default(now())
  updatedAt                        DateTime      @updatedAt

  table              CafeTable?          @relation(fields: [tableId], references: [id])
  createdBy          User                @relation("OrderCreatedBy", fields: [createdById], references: [id])
  deletedBy          User?               @relation("OrderDeletedBy", fields: [deletedById], references: [id])
  items              OrderItem[]
  paymentSettlements PaymentSettlement[]

  @@index([tableId, state])
  @@index([state, paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id                                 String        @id @default(uuid())
  orderId                            String
  productId                          String
  productNameSnapshot                String
  basePriceSnapshot                  Int
  preparationDeadlineSnapshotMinutes Int
  quantity                           Int
  note                               String?
  discountKind                       DiscountKind?
  discountValue                      Int?
  discountAmount                     Int           @default(0)
  discountReason                     String?
  lineTotalAmount                    Int
  displayOrder                       Int

  order                 Order                  @relation(fields: [orderId], references: [id])
  product               Product                @relation(fields: [productId], references: [id])
  options               OrderItemOption[]
  settlementAllocations SettlementAllocation[]

  @@index([orderId, displayOrder])
  @@index([productId])
  @@map("order_items")
}

model OrderItemOption {
  id                 String @id @default(uuid())
  orderItemId        String
  optionId           String
  optionNameSnapshot String
  priceSnapshot      Int
  quantity           Int

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  option    Option    @relation(fields: [optionId], references: [id])

  @@index([orderItemId])
  @@map("order_item_options")
}

model PaymentSettlement {
  id             String   @id @default(uuid())
  orderId        String
  recordedById   String
  idempotencyKey String
  totalAmount    Int
  recordedAt     DateTime @default(now())

  order       Order                  @relation(fields: [orderId], references: [id])
  recordedBy  User                   @relation(fields: [recordedById], references: [id])
  allocations SettlementAllocation[]
  payments    Payment[]
  reversal    SettlementReversal?

  @@unique([orderId, idempotencyKey])
  @@index([recordedById])
  @@map("payment_settlements")
}

model SettlementAllocation {
  id           String @id @default(uuid())
  settlementId String
  orderItemId  String
  quantity     Int
  amount       Int

  settlement PaymentSettlement @relation(fields: [settlementId], references: [id])
  orderItem  OrderItem         @relation(fields: [orderItemId], references: [id])

  @@index([orderItemId])
  @@map("settlement_allocations")
}

model Payment {
  id           String        @id @default(uuid())
  settlementId String
  method       PaymentMethod
  amount       Int
  reference    String?
  recordedAt   DateTime      @default(now())

  settlement PaymentSettlement @relation(fields: [settlementId], references: [id])

  @@index([settlementId])
  @@map("payments")
}

model SettlementReversal {
  id           String   @id @default(uuid())
  settlementId String   @unique
  recordedById String
  reason       String
  recordedAt   DateTime @default(now())

  settlement PaymentSettlement @relation(fields: [settlementId], references: [id])
  recordedBy User              @relation(fields: [recordedById], references: [id])

  @@index([recordedById])
  @@map("settlement_reversals")
}

model IdempotencyRecord {
  id                 String   @id @default(uuid())
  actorId            String
  operation          String
  key                String
  requestFingerprint String
  responseStatus     Int
  resultSnapshot     Json
  expiresAt          DateTime
  createdAt          DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@unique([actorId, operation, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model AuditLog {
  id             String   @id @default(uuid())
  actorId        String?
  requestId      String
  operation      String
  entityType     String
  entityId       String
  beforeSnapshot Json?
  afterSnapshot  Json?
  reason         String?
  occurredAt     DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([occurredAt])
  @@map("audit_logs")
}

model CafeSettings {
  id                              String   @id @default(uuid())
  singletonKey                    Boolean  @unique @default(true)
  defaultTableSeatingLimitMinutes Int      @default(45)
  updatedById                     String?
  updatedAt                       DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("cafe_settings")
}
