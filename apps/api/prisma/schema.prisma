generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = "DATABASE_URL"
}

enum UserRole {
  MANAGER
  STAFF
}

enum OrderChannel {
  TABLE
  TAKEAWAY
}

enum OrderState {
  OPEN
  CLOSED
  DELETED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum DiscountKind {
  FIXED
  PERCENTAGE
}

enum ProductPricingMode {
  FIXED
  WEIGHTED_PER_KG
}

enum CategoryKind {
  SOURCE
  PROMOTIONAL
}

enum PaymentMethod {
  CASH
  CARD_TERMINAL
  CARD_TRANSFER
}

enum TableOccupancyState {
  AVAILABLE
  OCCUPIED
}

enum InventoryUnit {
  GRAM
  MILLILITER
  PIECE
}

enum InventoryMovementKind {
  OPENING_COUNT
  PURCHASE_RECEIPT
  ORDER_CONSUMPTION
  ORDER_RESTORATION
  PHYSICAL_COUNT_ADJUSTMENT
  PURCHASE_RETURN
}

enum PurchaseStatus {
  DRAFT
  POSTED
}

enum InventoryCountKind {
  OPENING
  PHYSICAL
}

enum InventoryCountStatus {
  DRAFT
  POSTED
}

enum RecipeComponentKind {
  STOCK_ITEM
  RECIPE
}

enum ProductCostingMode {
  RECIPE
  PURCHASED_ITEM
}

enum CostingRuleAction {
  REPLACE_COMPONENT
  CHANGE_QUANTITY
  ADD_COMPONENT
}

enum OrderConsumptionStatus {
  PENDING
  POSTED
  RECONCILED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshSessions              RefreshSession[]
  authEvents                   AuthEvent[]
  createdOrders                Order[]                       @relation("OrderCreatedBy")
  deletedOrders                Order[]                       @relation("OrderDeletedBy")
  paymentSettlements           PaymentSettlement[]
  settlementReversals          SettlementReversal[]
  idempotencyRecords           IdempotencyRecord[]
  auditLogs                    AuditLog[]
  cafeSettingsUpdates          CafeSettings[]
  createdStockItems            StockItem[]                   @relation("StockItemCreatedBy")
  createdPurchases             Purchase[]                    @relation("PurchaseCreatedBy")
  createdInventoryCounts       InventoryCount[]              @relation("InventoryCountCreatedBy")
  inventoryMovements           InventoryMovement[]           @relation("InventoryMovementCreatedBy")
  orderConsumptions            OrderConsumption[]            @relation("OrderConsumptionRecognizedBy")
  updatedCostingConfigurations ProductCostingConfiguration[] @relation("CostingConfigurationUpdatedBy")

  @@map("users")
}

model RefreshSession {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_sessions")
}

model AuthEvent {
  id         String   @id @default(uuid())
  userId     String?
  eventType  String
  requestId  String
  occurredAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([occurredAt])
  @@map("auth_events")
}

model Category {
  id           String       @id @default(uuid())
  name         String
  displayOrder Int
  isActive     Boolean      @default(true)
  isPosVisible Boolean      @default(true)
  kind         CategoryKind @default(SOURCE)
  archivedAt   DateTime?

  products           Product[]
  productMemberships ProductCategoryMembership[]

  @@index([isActive, displayOrder])
  @@map("categories")
}

model Product {
  id                         String             @id @default(uuid())
  categoryId                 String
  name                       String
  menuNote                   String?            @db.VarChar(1000)
  priceAmount                Int
  pricingMode                ProductPricingMode @default(FIXED)
  isPublic                   Boolean            @default(true)
  systemKey                  String?
  saleDiscountKind           DiscountKind?
  saleDiscountValue          Int?
  preparationDeadlineMinutes Int
  displayOrder               Int
  isActive                   Boolean            @default(true)
  isAvailable                Boolean            @default(true)
  archivedAt                 DateTime?

  category             Category                     @relation(fields: [categoryId], references: [id])
  categoryMemberships  ProductCategoryMembership[]
  image                ProductImage?
  productOptionGroups  ProductOptionGroup[]
  orderItems           OrderItem[]
  costingConfiguration ProductCostingConfiguration?
  optionCostingRules   ProductOptionCostingRule[]
  optionRecipeCostings ProductOptionRecipeCosting[]
  costingCombinations  ProductCostingCombination[]

  @@unique([categoryId, systemKey])
  @@index([categoryId, isActive, isAvailable, displayOrder])
  @@map("products")
}

model ProductCategoryMembership {
  categoryId   String
  productId    String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([categoryId, productId])
  @@index([productId])
  @@index([categoryId, displayOrder])
  @@map("product_category_memberships")
}

model ProductImage {
  id         String @id @default(uuid())
  productId  String @unique
  storageKey String
  altText    String

  product Product @relation(fields: [productId], references: [id])

  @@map("product_images")
}

model OptionGroup {
  id         String    @id @default(uuid())
  name       String
  isActive   Boolean   @default(true)
  archivedAt DateTime?

  productOptionGroups ProductOptionGroup[]
  options             Option[]

  @@map("option_groups")
}

model ProductOptionGroup {
  productId     String
  optionGroupId String
  displayOrder  Int
  minSelections Int    @default(1)
  maxSelections Int    @default(1)

  product        Product                    @relation(fields: [productId], references: [id])
  optionGroup    OptionGroup                @relation(fields: [optionGroupId], references: [id])
  allowedOptions ProductOptionGroupOption[]

  @@id([productId, optionGroupId])
  @@map("product_option_groups")
}

model ProductOptionGroupOption {
  productId           String
  optionGroupId       String
  optionId            String
  displayOrder        Int
  priceAmountOverride Int?

  productOptionGroup ProductOptionGroup @relation(fields: [productId, optionGroupId], references: [productId, optionGroupId])
  option             Option             @relation(fields: [optionId, optionGroupId], references: [id, optionGroupId])

  @@id([productId, optionGroupId, optionId])
  @@index([optionId, optionGroupId])
  @@map("product_option_group_options")
}

model Option {
  id            String    @id @default(uuid())
  optionGroupId String
  name          String
  priceAmount   Int
  isActive      Boolean   @default(true)
  isAvailable   Boolean   @default(true)
  displayOrder  Int
  archivedAt    DateTime?

  optionGroup               OptionGroup                @relation(fields: [optionGroupId], references: [id])
  productLinks              ProductOptionGroupOption[]
  orderItemOptions          OrderItemOption[]
  recipeCostings            ProductOptionRecipeCosting[]
  optionCostingRules        ProductOptionCostingRule[]
  costingCombinationOptions CostingCombinationOption[]

  @@unique([optionGroupId, name])
  @@unique([id, optionGroupId])
  @@index([optionGroupId, isActive, isAvailable, displayOrder])
  @@map("options")
}

model CafeTable {
  id                        String              @id @default(uuid())
  name                      String
  displayOrder              Int
  isActive                  Boolean             @default(true)
  waiterCallEnabled         Boolean             @default(false)
  customerQrEnabled         Boolean             @default(false)
  occupancyState            TableOccupancyState @default(AVAILABLE)
  occupiedAt                DateTime?
  occupancyReminderAt       DateTime?
  customerAuthBypassEnabled Boolean             @default(false)
  tableContextInvalidBefore DateTime?
  archivedAt                DateTime?

  orders              Order[]
  qrCredentials       TableQrCredential[]
  waiterCalls         WaiterCall[]
  customerTableVisits CustomerTableVisit[]
  otpChallenges       CustomerOtpChallenge[]

  @@index([isActive, displayOrder])
  @@index([waiterCallEnabled, occupancyState])
  @@map("cafe_tables")
}

enum WaiterCallStatus {
  PENDING
  RESOLVED
}

model TableQrCredential {
  id        String    @id @default(uuid())
  tableId   String
  tokenHash String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  rotatedAt DateTime?

  table               CafeTable              @relation(fields: [tableId], references: [id])
  customerTableVisits CustomerTableVisit[]
  otpChallenges       CustomerOtpChallenge[]

  @@index([tableId])
  @@map("table_qr_credentials")
}

model WaiterCall {
  id                   String           @id @default(uuid())
  tableId              String
  status               WaiterCallStatus @default(PENDING)
  version              Int              @default(1)
  requestedAt          DateTime         @default(now())
  acknowledgedAt       DateTime?
  resolvedAt           DateTime?
  customerTableVisitId String?

  table              CafeTable           @relation(fields: [tableId], references: [id])
  customerTableVisit CustomerTableVisit? @relation(fields: [customerTableVisitId], references: [id], onDelete: SetNull)

  @@index([status, requestedAt])
  @@index([tableId, requestedAt])
  @@index([customerTableVisitId])
  @@map("waiter_calls")
}

enum CustomerOtpPurpose {
  TABLE_WAITER_CALL
}

model Customer {
  id                   String   @id @default(uuid())
  fullName             String?
  phoneLookupHash      String   @unique
  phoneNumberEncrypted String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  authSessions CustomerAuthSession[]
  tableVisits  CustomerTableVisit[]

  @@map("customers")
}

model CustomerOtpChallenge {
  id                String             @id @default(uuid())
  phoneLookupHash   String
  tableCredentialId String
  tableId           String
  purpose           CustomerOtpPurpose
  codeHash          String
  expiresAt         DateTime
  consumedAt        DateTime?
  attemptCount      Int                @default(0)
  resendAvailableAt DateTime
  createdAt         DateTime           @default(now())

  tableCredential TableQrCredential @relation(fields: [tableCredentialId], references: [id], onDelete: Restrict)
  table           CafeTable         @relation(fields: [tableId], references: [id], onDelete: Restrict)

  @@index([phoneLookupHash, purpose, createdAt])
  @@index([tableCredentialId, expiresAt])
  @@index([tableId, expiresAt])
  @@map("customer_otp_challenges")
}

model CustomerAuthSession {
  id         String    @id @default(uuid())
  customerId String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, expiresAt])
  @@map("customer_auth_sessions")
}

model CustomerTableVisit {
  id                String    @id @default(uuid())
  customerId        String
  tableId           String
  tableCredentialId String
  expiresAt         DateTime
  invalidatedAt     DateTime?
  lastActivityAt    DateTime?
  createdAt         DateTime  @default(now())

  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  table           CafeTable         @relation(fields: [tableId], references: [id], onDelete: Restrict)
  tableCredential TableQrCredential @relation(fields: [tableCredentialId], references: [id], onDelete: Restrict)
  waiterCalls     WaiterCall[]

  @@index([tableId, expiresAt])
  @@index([tableCredentialId, expiresAt])
  @@map("customer_table_visits")
}

model Order {
  id               String        @id @default(uuid())
  orderNumber      String        @unique
  dailyOrderNumber Int           @default(0)
  tableId          String?
  createdById      String
  channel          OrderChannel
  state            OrderState    @default(OPEN)
  paymentStatus    PaymentStatus @default(UNPAID)
  version          Int           @default(1)
  discountKind     DiscountKind?
  discountValue    Int?
  discountAmount   Int           @default(0)
  discountReason   String?
  subtotalAmount   Int
  totalAmount      Int
  paidAmount       Int           @default(0)
  balanceAmount    Int
  deletedById      String?
  deletedAt        DateTime?
  deletionReason   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  table                 CafeTable?             @relation(fields: [tableId], references: [id])
  createdBy             User                   @relation("OrderCreatedBy", fields: [createdById], references: [id])
  deletedBy             User?                  @relation("OrderDeletedBy", fields: [deletedById], references: [id])
  items                 OrderItem[]
  paymentSettlements    PaymentSettlement[]
  barTicketSnapshot     Json?
  barTicketSequence     Int                    @default(0)
  barTicketPreparations BarTicketPreparation[]
  orderConsumptions     OrderConsumption[]

  @@index([tableId, state])
  @@index([state, paymentStatus])
  @@index([createdAt])
  @@index([dailyOrderNumber])
  @@map("orders")
}

model DailyOrderSequence {
  businessDate String @id
  lastNumber   Int    @default(0)

  @@map("daily_order_sequences")
}

model OrderItem {
  id                  String             @id @default(uuid())
  orderId             String
  productId           String
  productNameSnapshot String
  basePriceSnapshot   Int
  pricingModeSnapshot ProductPricingMode @default(FIXED)
  weightGrams         Int?
  quantity            Int
  note                String?
  discountKind        DiscountKind?
  discountValue       Int?
  discountAmount      Int                @default(0)
  discountReason      String?
  lineTotalAmount     Int
  displayOrder        Int

  order                 Order                     @relation(fields: [orderId], references: [id])
  product               Product                   @relation(fields: [productId], references: [id])
  options               OrderItemOption[]
  settlementAllocations SettlementAllocation[]
  costingSnapshot       OrderItemCostingSnapshot?
  consumptionItems      OrderConsumptionItem[]

  @@index([orderId, displayOrder])
  @@index([productId])
  @@map("order_items")
}

model OrderItemOption {
  id                 String @id @default(uuid())
  orderItemId        String
  optionId           String
  optionNameSnapshot String
  priceSnapshot      Int
  quantity           Int

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  option    Option    @relation(fields: [optionId], references: [id])

  @@index([orderItemId])
  @@map("order_item_options")
}

model PaymentSettlement {
  id             String   @id @default(uuid())
  orderId        String
  recordedById   String
  idempotencyKey String
  totalAmount    Int
  recordedAt     DateTime @default(now())

  order             Order                  @relation(fields: [orderId], references: [id])
  recordedBy        User                   @relation(fields: [recordedById], references: [id])
  allocations       SettlementAllocation[]
  payments          Payment[]
  reversal          SettlementReversal?
  orderConsumptions OrderConsumption[]

  @@unique([orderId, idempotencyKey])
  @@index([recordedById])
  @@index([recordedAt, id])
  @@map("payment_settlements")
}

model SettlementAllocation {
  id           String @id @default(uuid())
  settlementId String
  orderItemId  String
  quantity     Int // Zero denotes the fractional item portion of an amount-based settlement.
  amount       Int

  settlement PaymentSettlement @relation(fields: [settlementId], references: [id])
  orderItem  OrderItem         @relation(fields: [orderItemId], references: [id])

  @@index([orderItemId])
  @@map("settlement_allocations")
}

model Payment {
  id           String        @id @default(uuid())
  settlementId String
  method       PaymentMethod
  amount       Int
  reference    String?
  recordedAt   DateTime      @default(now())

  settlement PaymentSettlement @relation(fields: [settlementId], references: [id])

  @@index([settlementId])
  @@map("payments")
}

model SettlementReversal {
  id           String   @id @default(uuid())
  settlementId String   @unique
  recordedById String
  reason       String?
  recordedAt   DateTime @default(now())

  settlement PaymentSettlement @relation(fields: [settlementId], references: [id])
  recordedBy User              @relation(fields: [recordedById], references: [id])

  @@index([recordedById])
  @@index([recordedAt])
  @@map("settlement_reversals")
}

model IdempotencyRecord {
  id                 String   @id @default(uuid())
  actorId            String
  operation          String
  key                String
  requestFingerprint String
  responseStatus     Int
  resultSnapshot     Json
  expiresAt          DateTime
  createdAt          DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@unique([actorId, operation, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model AuditLog {
  id             String   @id @default(uuid())
  actorId        String?
  requestId      String
  operation      String
  entityType     String
  entityId       String
  beforeSnapshot Json?
  afterSnapshot  Json?
  reason         String?
  occurredAt     DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([occurredAt, id])
  @@index([entityType, entityId, occurredAt, id])
  @@map("audit_logs")
}

model CafeSettings {
  id                       String   @id @default(uuid())
  singletonKey             Boolean  @unique @default(true)
  tableSeatingLimitMinutes Int?
  inventoryActivatedAt     DateTime?
  updatedById              String?
  updatedAt                DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("cafe_settings")
}

model BarTicketPreparation {
  id        String   @id @default(uuid())
  sequence  Int      @unique @default(autoincrement())
  orderId   String
  snapshot  Json
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("bar_ticket_preparations")
}

model StockItem {
  id           String        @id @default(uuid())
  name         String        @unique
  archivedName String?
  category     String
  baseUnit     InventoryUnit
  isActive     Boolean       @default(true)
  archivedAt   DateTime?
  version      Int           @default(1)
  createdById  String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  createdBy         User                            @relation("StockItemCreatedBy", fields: [createdById], references: [id])
  conversions       StockUnitConversion[]
  balance           InventoryBalance?
  purchaseLines     PurchaseLine[]
  recipeComponents  RecipeComponent[]               @relation("StockRecipeComponents")
  purchasedCostings ProductCostingConfiguration[]   @relation("PurchasedStockItem")
  optionRules       ProductOptionCostingRule[]      @relation("OptionRuleStockItem")
  combinationRules  ProductCombinationCostingRule[] @relation("CombinationRuleStockItem")
  countLines        InventoryCountLine[]
  movements         InventoryMovement[]

  @@index([isActive, category, name])
  @@map("stock_items")
}

model StockUnitConversion {
  id                  String   @id @default(uuid())
  stockItemId         String
  label               String
  baseQuantityPerPack Decimal  @db.Decimal(20, 6)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  stockItem     StockItem      @relation(fields: [stockItemId], references: [id])
  purchaseLines PurchaseLine[]

  @@unique([stockItemId, label])
  @@index([stockItemId, isActive])
  @@map("stock_unit_conversions")
}

model InventoryBalance {
  stockItemId         String    @id
  quantityOnHand      Decimal   @default(0) @db.Decimal(20, 6)
  carryingValueAmount Int       @default(0)
  trackingStartedAt   DateTime?
  updatedAt           DateTime  @updatedAt

  stockItem StockItem @relation(fields: [stockItemId], references: [id])

  @@map("inventory_balances")
}

model Purchase {
  id          String         @id @default(uuid())
  status      PurchaseStatus @default(DRAFT)
  receivedAt  DateTime
  supplier    String?
  version     Int            @default(1)
  createdById String
  postedAt    DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  createdBy User           @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  lines     PurchaseLine[]

  @@index([status, receivedAt, id])
  @@map("purchases")
}

model PurchaseLine {
  id                   String   @id @default(uuid())
  purchaseId           String
  stockItemId          String
  conversionId         String?
  purchaseUnitLabel    String
  purchaseQuantity     Decimal  @db.Decimal(20, 6)
  baseQuantityPerPack  Decimal  @db.Decimal(20, 6)
  baseQuantityReceived Decimal  @db.Decimal(20, 6)
  directCostAmount     Int
  createdAt            DateTime @default(now())

  purchase   Purchase             @relation(fields: [purchaseId], references: [id])
  stockItem  StockItem            @relation(fields: [stockItemId], references: [id])
  conversion StockUnitConversion? @relation(fields: [conversionId], references: [id], onDelete: Restrict)
  movements  InventoryMovement[]

  @@index([purchaseId])
  @@index([stockItemId, purchaseId])
  @@map("purchase_lines")
}

model Recipe {
  id            String        @id @default(uuid())
  name          String        @unique
  ingredientName String
  archivedName  String?
  outputUnit    InventoryUnit
  yieldQuantity Decimal       @db.Decimal(20, 6)
  version       Int           @default(1)
  isActive      Boolean       @default(true)
  archivedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  components       RecipeComponent[]               @relation("RecipeComponents")
  nestedIn         RecipeComponent[]               @relation("NestedRecipeComponents")
  productCostings  ProductCostingConfiguration[]   @relation("ProductRecipe")
  optionCostings   ProductOptionRecipeCosting[]
  extrasCostings   ProductCostingConfiguration[]   @relation("ProductExtrasRecipe")
  optionRules      ProductOptionCostingRule[]      @relation("OptionRuleRecipe")
  combinationRules ProductCombinationCostingRule[] @relation("CombinationRuleRecipe")

  @@index([isActive, name])
  @@map("recipes")
}

model RecipeComponent {
  id             String              @id @default(uuid())
  recipeId       String
  componentKey   String
  label          String
  sourceKind     RecipeComponentKind
  stockItemId    String?
  nestedRecipeId String?
  quantity       Decimal             @db.Decimal(20, 6)
  displayOrder   Int                 @default(0)

  recipe       Recipe     @relation("RecipeComponents", fields: [recipeId], references: [id])
  stockItem    StockItem? @relation("StockRecipeComponents", fields: [stockItemId], references: [id], onDelete: Restrict)
  nestedRecipe Recipe?    @relation("NestedRecipeComponents", fields: [nestedRecipeId], references: [id], onDelete: Restrict)

  @@unique([recipeId, componentKey])
  @@index([stockItemId])
  @@index([nestedRecipeId])
  @@map("recipe_components")
}

model ProductCostingConfiguration {
  id                   String             @id @default(uuid())
  productId            String             @unique
  mode                 ProductCostingMode
  recipeId             String?
  recipeQuantity       Decimal?           @db.Decimal(20, 6)
  purchasedStockItemId String?
  purchasedQuantity    Decimal?           @db.Decimal(20, 6)
  extrasRecipeId       String?
  version              Int                @default(1)
  updatedById          String
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  product            Product    @relation(fields: [productId], references: [id])
  recipe             Recipe?    @relation("ProductRecipe", fields: [recipeId], references: [id], onDelete: Restrict)
  purchasedStockItem StockItem? @relation("PurchasedStockItem", fields: [purchasedStockItemId], references: [id], onDelete: Restrict)
  extrasRecipe       Recipe?    @relation("ProductExtrasRecipe", fields: [extrasRecipeId], references: [id], onDelete: Restrict)
  updatedBy          User       @relation("CostingConfigurationUpdatedBy", fields: [updatedById], references: [id])

  @@index([recipeId])
  @@index([purchasedStockItemId])
  @@map("product_costing_configurations")
}

model ProductOptionCostingRule {
  id                     String            @id @default(uuid())
  productId              String
  optionId               String
  action                 CostingRuleAction
  componentKey           String
  label                  String?
  replacementStockItemId String?
  replacementRecipeId    String?
  quantity               Decimal?          @db.Decimal(20, 6)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  product              Product    @relation(fields: [productId], references: [id])
  option               Option     @relation(fields: [optionId], references: [id])
  replacementStockItem StockItem? @relation("OptionRuleStockItem", fields: [replacementStockItemId], references: [id], onDelete: Restrict)
  replacementRecipe    Recipe?    @relation("OptionRuleRecipe", fields: [replacementRecipeId], references: [id], onDelete: Restrict)

  @@unique([productId, optionId, componentKey])
  @@index([optionId])
  @@map("product_option_costing_rules")
}

model ProductOptionRecipeCosting {
  id            String   @id @default(uuid())
  productId     String
  optionId      String
  recipeId      String
  recipeQuantity Decimal @db.Decimal(20, 6)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  option  Option  @relation(fields: [optionId], references: [id], onDelete: Restrict)
  recipe  Recipe  @relation(fields: [recipeId], references: [id], onDelete: Restrict)

  @@unique([productId, optionId])
  @@index([optionId])
  @@index([recipeId])
  @@map("product_option_recipe_costings")
}

model ProductCostingCombination {
  id        String   @id @default(uuid())
  productId String
  name      String
  version   Int      @default(1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product                         @relation(fields: [productId], references: [id])
  options CostingCombinationOption[]
  rules   ProductCombinationCostingRule[]

  @@unique([productId, name])
  @@index([productId, isActive])
  @@map("product_costing_combinations")
}

model CostingCombinationOption {
  combinationId String
  optionId      String

  combination ProductCostingCombination @relation(fields: [combinationId], references: [id])
  option      Option                    @relation(fields: [optionId], references: [id])

  @@id([combinationId, optionId])
  @@index([optionId])
  @@map("costing_combination_options")
}

model ProductCombinationCostingRule {
  id                     String            @id @default(uuid())
  combinationId          String
  action                 CostingRuleAction
  componentKey           String
  label                  String?
  replacementStockItemId String?
  replacementRecipeId    String?
  quantity               Decimal?          @db.Decimal(20, 6)

  combination          ProductCostingCombination @relation(fields: [combinationId], references: [id])
  replacementStockItem StockItem?                @relation("CombinationRuleStockItem", fields: [replacementStockItemId], references: [id], onDelete: Restrict)
  replacementRecipe    Recipe?                   @relation("CombinationRuleRecipe", fields: [replacementRecipeId], references: [id], onDelete: Restrict)

  @@unique([combinationId, componentKey])
  @@map("product_combination_costing_rules")
}

model InventoryCount {
  id          String               @id @default(uuid())
  kind        InventoryCountKind
  status      InventoryCountStatus @default(DRAFT)
  version     Int                  @default(1)
  reason      String?              @db.VarChar(500)
  createdById String
  postedAt    DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  createdBy              User                         @relation("InventoryCountCreatedBy", fields: [createdById], references: [id])
  lines                  InventoryCountLine[]
  reconciledConsumptions InventoryCountPendingOrder[]

  @@index([status, createdAt, id])
  @@map("inventory_counts")
}

model InventoryCountLine {
  id                    String   @id @default(uuid())
  countId               String
  stockItemId           String
  expectedQuantity      Decimal? @db.Decimal(20, 6)
  observedQuantity      Decimal  @db.Decimal(20, 6)
  differenceQuantity    Decimal? @db.Decimal(20, 6)
  expectedValueAmount   Int?
  observedValueAmount   Int
  differenceValueAmount Int?

  count     InventoryCount     @relation(fields: [countId], references: [id])
  stockItem StockItem          @relation(fields: [stockItemId], references: [id])
  movement  InventoryMovement?

  @@unique([countId, stockItemId])
  @@index([stockItemId])
  @@map("inventory_count_lines")
}

model InventoryCountPendingOrder {
  countId            String
  orderConsumptionId String
  reconciledAt       DateTime @default(now())

  count            InventoryCount   @relation(fields: [countId], references: [id])
  orderConsumption OrderConsumption @relation(fields: [orderConsumptionId], references: [id])

  @@id([countId, orderConsumptionId])
  @@index([orderConsumptionId])
  @@map("inventory_count_pending_orders")
}

model InventoryMovement {
  id                    String                @id @default(uuid())
  stockItemId           String
  kind                  InventoryMovementKind
  quantityDelta         Decimal               @db.Decimal(20, 6)
  valueDeltaAmount      Int
  purchaseLineId        String?
  orderConsumptionId    String?
  inventoryCountLineId  String?               @unique
  compensatesMovementId String?               @unique
  createdById           String
  occurredAt            DateTime
  recordedAt            DateTime              @default(now())

  stockItem          StockItem           @relation(fields: [stockItemId], references: [id])
  purchaseLine       PurchaseLine?       @relation(fields: [purchaseLineId], references: [id], onDelete: Restrict)
  orderConsumption   OrderConsumption?   @relation(fields: [orderConsumptionId], references: [id], onDelete: Restrict)
  inventoryCountLine InventoryCountLine? @relation(fields: [inventoryCountLineId], references: [id], onDelete: Restrict)
  compensates        InventoryMovement?  @relation("InventoryMovementCompensation", fields: [compensatesMovementId], references: [id], onDelete: Restrict)
  compensatedBy      InventoryMovement?  @relation("InventoryMovementCompensation")
  createdBy          User                @relation("InventoryMovementCreatedBy", fields: [createdById], references: [id])

  @@index([stockItemId, recordedAt, id])
  @@index([orderConsumptionId, kind])
  @@index([purchaseLineId])
  @@map("inventory_movements")
}

model OrderItemCostingSnapshot {
  id                   String   @id @default(uuid())
  orderItemId          String   @unique
  configurationVersion Int?
  snapshot             Json
  isComplete           Boolean  @default(false)
  missingReasons       Json?
  updatedAt            DateTime @updatedAt

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@map("order_item_costing_snapshots")
}

model OrderConsumption {
  id                    String                 @id @default(uuid())
  orderId               String
  cycleNumber           Int
  paymentSettlementId   String
  status                OrderConsumptionStatus @default(PENDING)
  recognizedById        String
  recognizedAt          DateTime
  theoreticalCogsAmount Int?
  knownCogsAmount       Int                    @default(0)
  isCostComplete        Boolean                @default(false)
  costSnapshot          Json
  resolvedAt            DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  order             Order                        @relation(fields: [orderId], references: [id])
  paymentSettlement PaymentSettlement            @relation(fields: [paymentSettlementId], references: [id])
  recognizedBy      User                         @relation("OrderConsumptionRecognizedBy", fields: [recognizedById], references: [id])
  items             OrderConsumptionItem[]
  movements         InventoryMovement[]
  countLinks        InventoryCountPendingOrder[]

  @@unique([orderId, cycleNumber])
  @@unique([orderId, paymentSettlementId])
  @@index([status, recognizedAt, id])
  @@map("order_consumptions")
}

model OrderConsumptionItem {
  id                    String  @id @default(uuid())
  orderConsumptionId    String
  orderItemId           String
  productNameSnapshot   String
  quantity              Int
  weightGrams           Int?
  theoreticalCogsAmount Int?
  knownCogsAmount       Int     @default(0)
  isCostComplete        Boolean @default(false)
  costSnapshot          Json

  orderConsumption OrderConsumption @relation(fields: [orderConsumptionId], references: [id])
  orderItem        OrderItem        @relation(fields: [orderItemId], references: [id])

  @@unique([orderConsumptionId, orderItemId])
  @@index([orderItemId])
  @@map("order_consumption_items")
}
