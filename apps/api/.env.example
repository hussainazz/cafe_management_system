NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=debug

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public

# Required only by `pnpm db:bootstrap-manager`. Username must be lowercase and unique.
BOOTSTRAP_MANAGER_USERNAME=
# Use a unique, strong password.
BOOTSTRAP_MANAGER_PASSWORD=

ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
# Browser-visible base path for POS session cookies. Keep this default unless
# the POS reverse proxy exposes the API below a different path.
AUTH_COOKIE_BASE_PATH=/api/v1
TABLE_QR_TOKEN_SECRET=
TABLE_CONTEXT_COOKIE_SECRET=

# Optional SEP integration. Provision a random 32-byte hex key directly to the
# backend and private Windows configuration; never send it to JavaScript.
SEP_TERMINAL_ENABLED=false
# SEP_BRIDGE_ID=<installation UUID>
# SEP_TERMINAL_ID=31187710
# SEP_BRIDGE_HMAC_KEY=<random 64-character lowercase hex key>
