  "narrative": {
    "northStar": "Charcoal panels, amber actions",
    "overview": "This document records the approved inventory exception inside Run Cafe POS. Its tokens apply only within the inventory workspace. The surrounding POS retains its incumbent light and dark themes, cream or espresso surfaces, and existing controls. Do not apply these inventory tokens to the global theme or unrelated screens.\n\nThe owner's supplied screenshots establish the visual authority: Image 4 for the overview, Image 1 for the stock inspector, and Image 2 for the profit report. The implemented world uses charcoal panels, amber actions, green profit, thin warm borders, Estedad and Persian RTL. Text and operational SVG icons identify inventory items. Product images are excluded throughout inventory. There is no generated concept, concept-roll seed, shipping raster asset, or raster provenance to record.",
    "keyCharacteristics": [
      "Inventory remains dark in both surrounding POS themes.",
      "Amber marks actions and selection; green and red support explicit operational values and status text.",
      "Persian RTL, Persian numbers, Toman labels and visible unknown values preserve accounting clarity.",
      "Bordered panels, tables and charts keep stock work accessible on desktop and phone."
    ],
    "rules": [
      {
        "name": "The Scoped Inventory Rule",
        "body": "Keep this dark palette inside inventory, independent of the surrounding POS theme.",
        "section": "colors"
      },
      {
        "name": "The Accounting State Rule",
        "body": "Keep an unknown amount visibly unknown. Use text alongside color for stock status, missing costs and negative values; never draw an unknown cost as zero.",
        "section": "colors"
      },
      {
        "name": "The Numeric Clarity Rule",
        "body": "Keep quantities and money paired with their units and Toman labels. Preserve bidirectional isolation where used and tabular numerals on numeric details and activity totals.",
        "section": "typography"
      },
      {
        "name": "The Border and Tone Rule",
        "body": "Use the panel border and charcoal tonal change to separate inventory regions. Keep recurring panels shadowless.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep inventory dark and scoped while preserving the surrounding light/dark POS identity.",
      "**Do** use Estedad, Persian RTL, explicit units, Toman labels and legible numeric alignment.",
      "**Do** preserve visible unknown-cost states and gaps in charts when costs are incomplete.",
      "**Do** retain focus outlines, keyboard-accessible scroll regions, day selectors and reduced-motion behavior.",
      "**Do** keep stock information, alerts and actions visible within the compact working layout."
    ],
    "donts": [
      "**Don't** add product images anywhere in inventory.",
      "**Don't** spread the inventory palette or screenshot compositions into unrelated POS screens.",
      "**Don't** replace operational status text with color alone or silently render unknown amounts as zero.",
      "**Don't** add glassmorphism, marketing heroes, decorative shadows or distracting animation to inventory.",
      "**Don't** infer forecasts, automatic purchasing, a generated concept seed or shipping raster assets from this build."
    ]
  }
}
