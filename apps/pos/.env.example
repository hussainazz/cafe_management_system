# Server-only URL used by the POS Next.js rewrite to reach Fastify.
# In production, configure this as the internal API origin; browsers continue to
# use the same-origin /api/v1 path so authenticated cookies remain scoped safely.
API_BASE_URL=http://127.0.0.1:3001

# Health-only diagnostic route; does not enable terminal payments. Off by default.
SEP_BRIDGE_DIAGNOSTICS_ENABLED=false
SEP_BRIDGE_PORT=18711
# Build-time loopback port for the explicit terminal purchase fetch (backend flag stays off).
NEXT_PUBLIC_SEP_BRIDGE_PORT=18711
