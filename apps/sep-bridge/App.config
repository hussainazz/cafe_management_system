<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" /></startup>
  <appSettings>
    <add key="Port" value="18711" />
    <add key="AllowedOrigin" value="https://runncafe.ir" />
    <!-- Empty means %LOCALAPPDATA%\RunCafe\SepBridge.Health. -->
    <add key="DataDirectory" value="" />
  </appSettings>
</configuration>
