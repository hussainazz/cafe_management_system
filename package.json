{
  "name": "cafe-management-system",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @cafe/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @cafe/api prisma:generate",
    "db:migrate": "pnpm --filter @cafe/api prisma:migrate",
    "db:studio": "pnpm --filter @cafe/api prisma:studio",
    "db:seed": "pnpm --filter @cafe/api prisma:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.0.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "tsx": "^4.23.1",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
