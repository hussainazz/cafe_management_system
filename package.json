{
  "name": "cafe-management-system",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @cafe/api --filter @cafe/web --filter @cafe/pos dev",
    "dev:api": "pnpm --filter @cafe/api dev",
    "dev:web": "pnpm --filter @cafe/web dev",
    "dev:pos": "pnpm --filter @cafe/pos dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @cafe/web build",
    "build:pos": "pnpm --filter @cafe/pos build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @cafe/api prisma:generate",
    "db:migrate": "pnpm --filter @cafe/api prisma:migrate",
    "db:studio": "pnpm --filter @cafe/api prisma:studio",
    "db:seed": "pnpm --filter @cafe/api prisma:seed",
    "db:seed:run-cafe-menu": "pnpm --filter @cafe/api seed:run-cafe-menu",
    "db:bootstrap-manager": "pnpm --filter @cafe/api bootstrap:manager",
    "auth:manager": "pnpm --filter @cafe/api provision:dev-pos-manager",
    "auth:staff": "pnpm --filter @cafe/api provision:dev-pos-staff",
    "test:api": "pnpm --filter @cafe/api test",
    "test:web": "pnpm --filter @cafe/web test",
    "test:pos": "pnpm --filter @cafe/pos test",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.0.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "tsx": "^4.23.1",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
